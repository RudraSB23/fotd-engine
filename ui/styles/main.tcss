/* main.tcss */

App, Screen {
  background: #111;
  color: white;
  width: 100%;
  height: 100%;
  align: center middle;
  padding: 0;
  margin: 0;
}

#main-shell {
  width: 100%;
  height: 100%;
  align: center middle;
}

Button:focus,
Button:focus .button--label {
  text-style: none;
  border: none;
}
