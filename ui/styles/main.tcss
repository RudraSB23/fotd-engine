/* ui/styles/main.tcss */

Screen {
  background: #111;
  color: white;
  width: 100vw;
  height: 100vh;
  align: center middle;
  padding: 0;
  margin: 0;
}

#shell {
  min-width: 100%;
  min-height: 100%;
  align: center middle;
}

Button:focus,
Button:focus .button--label {
  text-style: none;
  border: none;
}
