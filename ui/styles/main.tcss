/* ui/styles/main.tcss */

Screen {
  background: #111;
  color: white;
  width: 100vw;
  height: 100vh;
  align: center middle;
  padding: 0;
  margin: 0;
}

#main-shell {
  width: 100%;
  height: 100%;
  align: center middle;
}

Button:focus,
Button:focus .button--label {
  text-style: none;
  border: none;
}

.nav-btn {
  width: 16;
  height: 3;
  background: #1a1a1a;
  color: #abcdef;
  border: tall #2a2a2a;
  margin-top: 1;
  content-align: center middle;
}

.nav-btn:hover {
  background: #252525;
  border: tall #abcdef;
}

.nav-btn:focus {
  background: #1a1a1a;
  border: tall #abcdef;
}

.nav-btn:focus .button--label {
  text-style: none;
  background: #1a1a1a;
}
